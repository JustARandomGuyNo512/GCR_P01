{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GCR: Run Client",
      "type": "process",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": [
        "runClient"
      ],
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": "$gradle"
    },
    {
      "label": "GCR: Run Server",
      "type": "process",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": [
        "runServer"
      ],
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": "$gradle"
    }
  ]
}
